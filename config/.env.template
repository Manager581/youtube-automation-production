# API Keys (Add when ready to upgrade from manual workflow)

# OpenAI (for GPT-4 scripts)
# OPENAI_API_KEY=your_key_here

# Anthropic Claude (for script generation)
# ANTHROPIC_API_KEY=your_key_here

# Google Gemini (if using API instead of manual)
# GOOGLE_API_KEY=your_key_here

# YouTube Data API (for uploads)
# YOUTUBE_CLIENT_ID=your_client_id
# YOUTUBE_CLIENT_SECRET=your_client_secret

# Optional: Runway ML (for AI video)
# RUNWAY_API_KEY=your_key_here

# Optional: ElevenLabs (for future voice cloning)
# ELEVENLABS_API_KEY=your_key_here

# NASA API (optional - public endpoint works without key)
# NASA_API_KEY=DEMO_KEY
