    "dominant_emotions": ["fear", "mystery", "tragedy"],
    "avoid_emotions": ["comedy", "inspiration", "celebration"],
    "title_angles_ranked": [
      {
        "pattern": "INSTITUTION_HOW",
        "avg_views": 11223342,
        "template": "How [Institution] [Shocking Action/Method]",
        "examples": ["How an FBI Agent Infiltrated the KKK"],
        "keywords": ["How the", "How an", "How a"]
      },
      {
        "pattern": "COUNTRY_DARK",
        "avg_views": 5592303,
        "template": "[Country]'s [Most/Hidden/Secret] [Dark Reality]",
        "examples": ["Camp 14: The Most Horrible Place in North Korea"],
        "keywords": ["North Korea", "Russia", "China", "Iran", "Cuba", "Soviet"]
      },
      {
        "pattern": "PERSON_GENIUS_TRAGEDY",
        "avg_views": 4155154,
        "template": "The [Person] Who [Remarkable Achievement] (and [Dark Consequence])",
        "examples": ["The Kid Who Hacked the Pentagon (and paid with his life)"],
        "keywords": []
      },
      {
        "pattern": "THREAT_WHY",
        "avg_views": 3294900,
        "template": "Why [Thing] Is [Shocking/Dangerous Truth]",
        "examples": ["Why Fentanyl Is So Easy to Smuggle"],
        "keywords": ["Why the", "Why is", "Why are"]
      },
      {
        "pattern": "SUPERLATIVE",
        "avg_views": 3571700,
        "template": "The Most [Extreme Adjective] [Noun] in [Place/History]",
        "examples": ["The Most Secret Building in Manhattan"],
        "keywords": ["Most Secret", "Most Dangerous", "Most Horrifying", "Most Hidden"]
      }
    ]
  },

