  },

  "audio_style": {
    "music_type": "atmospheric_tension",
    "music_source": "Pixabay CC0",
    "dominant_sounds": ["tension_pad", "riser", "impact", "shimmer"],
    "forbidden": ["upbeat", "comedy", "pop"]
  },

  "production": {
    "voiceover": "F5-TTS cloned voice — measured, authoritative, urgent on reveals",
    "footage_sources": [
      "Wikimedia Commons",
      "Internet Archive",
      "Government archives",
      "News clips via yt-dlp (fair use, max 5s)",
      "Court/hearing footage",
      "Pexels (free stock for establishing shots only)"
    ],
    "forbidden_sources": ["Pixabay images", "AI-generated video"]
  }
}
