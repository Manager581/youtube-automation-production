# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
dist/
*.egg-info/

# API Keys & Config
.env
config/api_keys.json
config/secrets.json
service-account.json
*service_account*.json
cookies.txt
youtube-cookies.txt

# ─── Large Video / Audio files ────────────────────────────────────────────────
# Never commit raw videos or audio — too large, regenerable from YouTube
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wav
*.mp3
!assets/sfx/*.mp3
*.m4a
*.flac
*.aac
*.ogg
*.aiff
*.aif

# ─── Keyframe images — regenerable from videos ────────────────────────────────
**/hybrid_keyframes/
**/ground_truth_frames/
**/keyframes/

# ─── Heavy analysis artifacts ─────────────────────────────────────────────────
analysis/fern/audio_cache/
analysis/fern/demucs_out/
analysis/fern/thumbnails/

# ─── watop brand — not in scope ───────────────────────────────────────────────
analysis/watop/
research/watop/

# ─── Assets that are too large or private ─────────────────────────────────────
assets/raw_footage/
assets/veo_clips/
assets/nasa_footage/
assets/voiceovers/
assets/music/
assets/voice/          # your personal voice recordings — keep private

# ─── Generated output ─────────────────────────────────────────────────────────
output/
temp/
footage/
# Rexcaped stat cards + placeholder slates — regenerable from the engine plan
# via scripts/rexcaped_stat_cards.py (don't bloat the repo with render PNGs)
assets/*/cards/

# ─── Checkpoint backups ───────────────────────────────────────────────────────
analysis/fern/.checkpoint.json.backup*

# ─── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log

# ─── OS / IDE ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ─── QR codes (unrelated to Fern pipeline) ────────────────────────────────────
qr_codes/
.animation_cache/
.claude/worktrees/

# ─── External tools (vendored submodules, not part of project) ───────────────
tools/ltx-video/

# ── venvs rebuilt locally + iCloud-excluded (reproduce from requirements*.txt) ──
*.nosync
/venv
*.icloud_old
requirements.txt.bak
# vendored LTX-Video clone (regenerate: git clone Lightricks/LTX-Video + pip install -e; weights via HF)
/tools/ltx-video/
assets/*/intro_cards/

*.prebak
