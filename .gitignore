# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
dist/
*.egg-info/

# API Keys & Config
.env
config/api_keys.json
config/secrets.json
service-account.json
*service_account*.json
cookies.txt
